{
  "$name": "Enspire Core",
  "$description": "Structure, roles and component contracts. Brand-agnostic: every color here references a theme palette stop, never a raw value. Do not edit this file to re-skin a project — edit the theme.",
  "$convention": "$value = light mode. $dark = dark mode (omit when identical). $scale = 'density' | 'radius' wraps the value in calc() against the matching personality knob.",

  "scale": {
    "space": {
      "$description": "8px base unit. Suffix is the percentage of base: space.200 = 200% of 8px = 16px. Every step scales with density.",
      "$scale": "density",
      "0":    { "$type": "dimension", "$value": "0px" },
      "025":  { "$type": "dimension", "$value": "2px" },
      "050":  { "$type": "dimension", "$value": "4px" },
      "075":  { "$type": "dimension", "$value": "6px" },
      "100":  { "$type": "dimension", "$value": "8px" },
      "150":  { "$type": "dimension", "$value": "12px" },
      "200":  { "$type": "dimension", "$value": "16px" },
      "250":  { "$type": "dimension", "$value": "20px" },
      "300":  { "$type": "dimension", "$value": "24px" },
      "400":  { "$type": "dimension", "$value": "32px" },
      "500":  { "$type": "dimension", "$value": "40px" },
      "600":  { "$type": "dimension", "$value": "48px" },
      "800":  { "$type": "dimension", "$value": "64px" },
      "1000": { "$type": "dimension", "$value": "80px" }
    },

    "space-negative": {
      "$description": "For breaking out of container padding or overlapping elements. Try a Bleed primitive first.",
      "$scale": "density",
      "025": { "$type": "dimension", "$value": "-2px" },
      "050": { "$type": "dimension", "$value": "-4px" },
      "100": { "$type": "dimension", "$value": "-8px" },
      "150": { "$type": "dimension", "$value": "-12px" },
      "200": { "$type": "dimension", "$value": "-16px" },
      "300": { "$type": "dimension", "$value": "-24px" },
      "400": { "$type": "dimension", "$value": "-32px" }
    },

    "radius": {
      "$description": "Radius matches element size. Scales with the radius personality knob, except full.",
      "$scale": "radius",
      "xsmall":  { "$type": "dimension", "$value": "2px",  "$use": "Badges, checkboxes, avatar labels, keyboard shortcuts" },
      "small":   { "$type": "dimension", "$value": "4px",  "$use": "Labels, lozenges, tags, timestamps, tooltips, compact buttons" },
      "medium":  { "$type": "dimension", "$value": "8px",  "$use": "Buttons, inputs, textareas, selects, navigation items" },
      "large":   { "$type": "dimension", "$value": "12px", "$use": "Cards, in-page containers, floating UI, dropdown menus" },
      "xlarge":  { "$type": "dimension", "$value": "16px", "$use": "Full-page containers, modal dialogs, kanban columns, tables" },
      "xxlarge": { "$type": "dimension", "$value": "24px", "$use": "Video players" },
      "full":    { "$type": "dimension", "$value": "9999px", "$scale": "none", "$use": "Pills and circles ONLY. Never rectangular containers." }
    },

    "border-width": {
      "$description": "Added in Faza 0 — the source MD had no border-width tokens, which forced raw 1px everywhere.",
      "thin":   { "$type": "dimension", "$value": "1px" },
      "medium": { "$type": "dimension", "$value": "2px" },
      "thick":  { "$type": "dimension", "$value": "4px" }
    },

    "text-size": {
      "xs": { "$type": "dimension", "$value": "0.75rem",  "$use": "Captions, metadata" },
      "sm": { "$type": "dimension", "$value": "0.875rem", "$use": "Small UI text" },
      "md": { "$type": "dimension", "$value": "1rem",     "$use": "Body text (default)" },
      "lg": { "$type": "dimension", "$value": "1.125rem", "$use": "Emphasized paragraphs" },
      "xl": { "$type": "dimension", "$value": "1.25rem",  "$use": "Intro / highlight text" }
    },

    "heading-size": {
      "xs": { "$type": "dimension", "$value": "1.125rem", "$use": "Small section headers" },
      "sm": { "$type": "dimension", "$value": "1.25rem",  "$use": "Card titles" },
      "md": { "$type": "dimension", "$value": "1.5rem",   "$use": "Section titles" },
      "lg": { "$type": "dimension", "$value": "2rem",     "$use": "Page titles" },
      "xl": { "$type": "dimension", "$value": "3rem",     "$use": "Hero / marketing headers" }
    },

    "weight": {
      "light":     { "$type": "number", "$value": 300, "$use": "Hero subtitles and large pull quotes only. Never below 16px." },
      "regular":   { "$type": "number", "$value": 400 },
      "medium":    { "$type": "number", "$value": 500 },
      "semibold":  { "$type": "number", "$value": 600 },
      "bold":      { "$type": "number", "$value": 700 },
      "extrabold": { "$type": "number", "$value": 800 }
    },

    "text-leading": {
      "tight":   { "$type": "number", "$value": 1.25, "$use": "Dense UI, single-line labels" },
      "normal":  { "$type": "number", "$value": 1.5,  "$use": "Body" },
      "relaxed": { "$type": "number", "$value": 1.75, "$use": "Long-form prose" }
    },

    "heading-leading": {
      "tight":   { "$type": "number", "$value": 1.1,  "$use": "Display / hero" },
      "normal":  { "$type": "number", "$value": 1.25, "$use": "Section headings" },
      "relaxed": { "$type": "number", "$value": 1.4,  "$use": "Card titles, smaller headings" }
    },

    "text-tracking": {
      "tight":  { "$type": "dimension", "$value": "-0.01em", "$use": "Dense UI, table cells" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide":   { "$type": "dimension", "$value": "0.02em",  "$use": "Labels, captions" },
      "widest": { "$type": "dimension", "$value": "0.05em",  "$use": "ALL-CAPS badges only" }
    },

    "heading-tracking": {
      "tight":   { "$type": "dimension", "$value": "-0.02em", "$use": "Hero" },
      "normal":  { "$type": "dimension", "$value": "-0.01em", "$use": "H1-H2" },
      "relaxed": { "$type": "dimension", "$value": "0em",     "$use": "H3-H4" }
    }
  },

  "font": {
    "text":    { "$type": "fontFamily", "$value": "{typeface.text}" },
    "heading": { "$type": "fontFamily", "$value": "{typeface.heading}" }
  },

  "semantic": {
    "base": {
      "bg":             { "$type": "color", "$value": "{palette.canvas.50}",  "$dark": "{palette.canvas.950}", "$use": "Main site background" },
      "surface":        { "$type": "color", "$value": "{palette.canvas.0}",   "$dark": "{palette.canvas.900}", "$use": "Cards, containers, panels" },
      "surface-hover":  { "$type": "color", "$value": "{palette.canvas.100}", "$dark": "{palette.canvas.850}" },
      "surface-active": { "$type": "color", "$value": "{palette.canvas.200}", "$dark": "{palette.canvas.800}" },
      "elevated":       { "$type": "color", "$value": "{palette.canvas.0}",   "$dark": "{palette.canvas.800}", "$use": "Modals, dropdowns, overlays" }
    },

    "text": {
      "primary":   { "$type": "color", "$value": "{palette.ink.900}",     "$dark": "{palette.ink.d50}" },
      "secondary": { "$type": "color", "$value": "{palette.naviblue.600}", "$dark": "{palette.naviblue.d200}", "$use": "Headings, labels" },
      "tertiary":  { "$type": "color", "$value": "{palette.ink.300}",     "$dark": "{palette.ink.d200}", "$use": "Metadata, low emphasis" },
      "muted":     { "$type": "color", "$value": "{palette.ink.200}",     "$dark": "{palette.ink.d300}", "$use": "Hints and placeholders ONLY — below AA" },
      "disabled":  { "$type": "color", "$value": "{palette.ink.100}",     "$dark": "{palette.ink.d400}" },
      "inverted":  { "$type": "color", "$value": "{palette.ink.0}",       "$dark": "{palette.canvas.950}", "$use": "Text on colored fills" },
      "heading":   { "$type": "color", "$value": "{palette.ink.900}",     "$dark": "{palette.ink.d50}" }
    },

    "link": {
      "default":  { "$type": "color", "$value": "{palette.naviblue.500}", "$dark": "{palette.naviblue.d300}" },
      "hover":    { "$type": "color", "$value": "{palette.naviblue.600}", "$dark": "{palette.naviblue.d200}" },
      "active":   { "$type": "color", "$value": "{palette.naviblue.800}", "$dark": "{palette.naviblue.d100}" },
      "visited":  { "$type": "color", "$value": "{palette.violet.500}",   "$dark": "{palette.violet.d300}" },
      "disabled": { "$type": "color", "$value": "{palette.ink.100}",      "$dark": "{palette.ink.d400}" }
    },

    "primary": {
      "bg":            { "$type": "color", "$value": "{palette.naviblue.600}", "$dark": "{palette.naviblue.d500}" },
      "bg-hover":      { "$type": "color", "$value": "{palette.naviblue.700}", "$dark": "{palette.naviblue.d400}" },
      "bg-active":     { "$type": "color", "$value": "{palette.naviblue.800}", "$dark": "{palette.naviblue.d600}" },
      "text":          { "$type": "color", "$value": "{palette.naviblue.600}", "$dark": "{palette.naviblue.d200}" },
      "text-inverted": { "$type": "color", "$value": "{palette.ink.0}",        "$dark": "{palette.naviblue.900}" },
      "soft":          { "$type": "color", "$value": "{palette.naviblue.50}",  "$dark": "{palette.naviblue.d900}" },
      "surface":       { "$type": "color", "$value": "{palette.naviblue.100}", "$dark": "{palette.naviblue.d800}" },
      "strong":        { "$type": "color", "$value": "{palette.naviblue.500}", "$dark": "{palette.naviblue.d500}" }
    },

    "secondary": {
      "bg":            { "$type": "color", "$value": "{palette.verdant.500}", "$dark": "{palette.verdant.400}" },
      "bg-hover":      { "$type": "color", "$value": "{palette.verdant.600}", "$dark": "{palette.verdant.d300}" },
      "bg-active":     { "$type": "color", "$value": "{palette.verdant.700}", "$dark": "{palette.verdant.d500}" },
      "text":          { "$type": "color", "$value": "{palette.verdant.600}", "$dark": "{palette.verdant.d200}" },
      "text-inverted": { "$type": "color", "$value": "{palette.ink.0}",       "$dark": "{palette.verdant.900}" },
      "soft":          { "$type": "color", "$value": "{palette.verdant.50}",  "$dark": "{palette.verdant.900}" },
      "surface":       { "$type": "color", "$value": "{palette.verdant.100}", "$dark": "{palette.verdant.d900}" },
      "strong":        { "$type": "color", "$value": "{palette.verdant.400}", "$dark": "{palette.verdant.400}" }
    },

    "success": {
      "bg":            { "$type": "color", "$value": "{palette.green.500}", "$dark": "{palette.green.400}" },
      "bg-hover":      { "$type": "color", "$value": "{palette.green.600}", "$dark": "{palette.green.300}" },
      "bg-active":     { "$type": "color", "$value": "{palette.green.700}", "$dark": "{palette.green.500}" },
      "text":          { "$type": "color", "$value": "{palette.green.600}", "$dark": "{palette.green.200}" },
      "text-inverted": { "$type": "color", "$value": "{palette.ink.0}",     "$dark": "{palette.green.900}" },
      "soft":          { "$type": "color", "$value": "{palette.green.50}",  "$dark": "{palette.green.900}" },
      "surface":       { "$type": "color", "$value": "{palette.green.100}", "$dark": "{palette.green.800}" },
      "strong":        { "$type": "color", "$value": "{palette.green.400}", "$dark": "{palette.green.400}" }
    },

    "warning": {
      "bg":            { "$type": "color", "$value": "{palette.amber.500}", "$dark": "{palette.amber.400}" },
      "bg-hover":      { "$type": "color", "$value": "{palette.amber.600}", "$dark": "{palette.amber.300}" },
      "bg-active":     { "$type": "color", "$value": "{palette.amber.700}", "$dark": "{palette.amber.500}" },
      "text":          { "$type": "color", "$value": "{palette.amber.600}", "$dark": "{palette.amber.200}" },
      "text-inverted": { "$type": "color", "$value": "{palette.ink.0}",     "$dark": "{palette.amber.900}" },
      "soft":          { "$type": "color", "$value": "{palette.amber.50}",  "$dark": "{palette.amber.900}" },
      "surface":       { "$type": "color", "$value": "{palette.amber.100}", "$dark": "{palette.amber.800}" },
      "strong":        { "$type": "color", "$value": "{palette.amber.400}", "$dark": "{palette.amber.400}" }
    },

    "error": {
      "bg":            { "$type": "color", "$value": "{palette.red.500}", "$dark": "{palette.red.400}" },
      "bg-hover":      { "$type": "color", "$value": "{palette.red.600}", "$dark": "{palette.red.300}" },
      "bg-active":     { "$type": "color", "$value": "{palette.red.700}", "$dark": "{palette.red.500}" },
      "text":          { "$type": "color", "$value": "{palette.red.600}", "$dark": "{palette.red.200}" },
      "text-inverted": { "$type": "color", "$value": "{palette.ink.0}",   "$dark": "{palette.red.900}" },
      "soft":          { "$type": "color", "$value": "{palette.red.50}",  "$dark": "{palette.red.900}" },
      "surface":       { "$type": "color", "$value": "{palette.red.100}", "$dark": "{palette.red.800}" },
      "strong":        { "$type": "color", "$value": "{palette.red.400}", "$dark": "{palette.red.400}" }
    },

    "neutral": {
      "bg":      { "$type": "color", "$value": "{palette.slate.500}", "$dark": "{palette.slate.300}" },
      "text":    { "$type": "color", "$value": "{palette.slate.600}", "$dark": "{palette.slate.200}" },
      "soft":    { "$type": "color", "$value": "{palette.slate.50}",  "$dark": "{palette.slate.900}" },
      "surface": { "$type": "color", "$value": "{palette.slate.100}", "$dark": "{palette.slate.800}" },
      "strong":  { "$type": "color", "$value": "{palette.slate.200}", "$dark": "{palette.slate.700}", "$use": "Default control border" }
    },

    "state": {
      "hover":    { "$type": "color", "$value": "{palette.alpha.hover}",    "$dark": "{palette.alpha.d-hover}" },
      "active":   { "$type": "color", "$value": "{palette.alpha.active}",   "$dark": "{palette.alpha.d-active}" },
      "focus":    { "$type": "color", "$value": "{palette.naviblue.500}",   "$dark": "{palette.naviblue.d500}", "$use": "Focus ring: 2px, offset 2px, radius +2px" },
      "disabled": { "$type": "color", "$value": "{palette.alpha.disabled}", "$dark": "{palette.alpha.d-disabled}" }
    }
  },

  "component": {
    "$description": "Component tokens are named component-property-state and ALWAYS resolve through a semantic token, never a palette stop.",

    "input": {
      "background-default":  { "$type": "color", "$value": "{semantic.base.surface}" },
      "background-focus":    { "$type": "color", "$value": "{semantic.base.elevated}" },
      "background-disabled": { "$type": "color", "$value": "{semantic.neutral.soft}" },
      "border-default":      { "$type": "color", "$value": "{semantic.neutral.strong}" },
      "border-focus":        { "$type": "color", "$value": "{semantic.primary.strong}" },
      "border-error":        { "$type": "color", "$value": "{semantic.error.strong}" },
      "border-disabled":     { "$type": "color", "$value": "{semantic.neutral.soft}" },
      "text-default":        { "$type": "color", "$value": "{semantic.text.primary}" },
      "text-placeholder":    { "$type": "color", "$value": "{semantic.text.muted}" },
      "text-disabled":       { "$type": "color", "$value": "{semantic.text.disabled}" },
      "$note": "There is intentionally no input-text-focus: the typed value does not change color on focus."
    },

    "checkbox": {
      "background-default":  { "$type": "color", "$value": "{semantic.base.surface}" },
      "background-checked":  { "$type": "color", "$value": "{semantic.primary.bg}" },
      "background-disabled": { "$type": "color", "$value": "{semantic.neutral.soft}" },
      "border-default":      { "$type": "color", "$value": "{semantic.neutral.strong}" },
      "border-checked":      { "$type": "color", "$value": "{semantic.primary.bg-active}" },
      "border-focus":        { "$type": "color", "$value": "{semantic.primary.strong}" },
      "icon":                { "$type": "color", "$value": "{semantic.primary.text-inverted}" },
      "$note": "The checked border matches the brand fill, not neutral gray. The check icon is its own layer so dark mode can control it."
    },

    "select": {
      "background-default":  { "$type": "color", "$value": "{semantic.base.surface}" },
      "background-open":     { "$type": "color", "$value": "{semantic.base.elevated}" },
      "background-disabled": { "$type": "color", "$value": "{semantic.neutral.soft}" },
      "border-default":      { "$type": "color", "$value": "{semantic.neutral.strong}" },
      "border-focus":        { "$type": "color", "$value": "{semantic.primary.strong}" },
      "text-default":        { "$type": "color", "$value": "{semantic.text.primary}" },
      "text-placeholder":    { "$type": "color", "$value": "{semantic.text.muted}" },
      "menu-background":     { "$type": "color", "$value": "{semantic.base.elevated}" },
      "option-bg-hover":     { "$type": "color", "$value": "{semantic.primary.surface}" },
      "option-text-hover":   { "$type": "color", "$value": "{semantic.primary.text}" },
      "option-bg-selected":  { "$type": "color", "$value": "{semantic.primary.soft}" },
      "option-text-selected":{ "$type": "color", "$value": "{semantic.primary.text}" },
      "$note": "Hover and selected use different tokens on purpose: hover is transient, selected is persistent."
    }
  }
}
